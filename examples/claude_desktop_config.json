{
  "mcpServers": {
    "dev-radar-git": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "/ABSOLUTE/PATH/TO/dev-radar", "dev-radar-git"],
      "env": { "DEV_RADAR_REPO": "/ABSOLUTE/PATH/TO/YOUR/REPO" }
    },
    "dev-radar-hn": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "/ABSOLUTE/PATH/TO/dev-radar", "dev-radar-hn"]
    },
    "dev-radar-system": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "/ABSOLUTE/PATH/TO/dev-radar", "dev-radar-system"]
    },
    "dev-radar-github": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "/ABSOLUTE/PATH/TO/dev-radar", "dev-radar-github"],
      "env": { "DEV_RADAR_GITHUB_REPOS": "OWNER/REPO,OWNER/OTHER-REPO" }
    },
    "dev-radar-deps": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "/ABSOLUTE/PATH/TO/dev-radar", "dev-radar-deps"],
      "env": { "DEV_RADAR_REPO": "/ABSOLUTE/PATH/TO/YOUR/REPO" }
    },
    "dev-radar-calendar": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "/ABSOLUTE/PATH/TO/dev-radar", "dev-radar-calendar"],
      "env": { "DEV_RADAR_CALENDARS": "/ABSOLUTE/PATH/TO/work.ics" }
    },
    "dev-radar-research": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "/ABSOLUTE/PATH/TO/dev-radar", "dev-radar-research"],
      "env": { "DEV_RADAR_ARXIV_CATEGORIES": "cs.SE,cs.AI", "DEV_RADAR_FEEDS": "https://blog.rust-lang.org/feed.xml" }
    }
  }
}
